{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "*.pdf",
      "*.zip",
      "*.md",
      "docs/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/login.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
